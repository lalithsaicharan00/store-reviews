/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/ https://api.oftenenough.com https://api-dev.oftenenough.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Google's sign-in button sets inline styles; only the delete page loads it.
/delete-account
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/ https://api.oftenenough.com https://api-dev.oftenenough.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
