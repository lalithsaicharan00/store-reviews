# ---------------------------------------------------------------
# Research: working scratch for Claude Code / agent sessions.
# Contents are intentionally UNTRACKED — intermediate analysis
# artifacts, not deliverables. The README is tracked so the
# convention survives a fresh clone.
# ---------------------------------------------------------------
Research/Temp/*
!Research/Temp/README.md

# iOS / Xcode
iOS/**/DerivedData/
iOS/**/build/
iOS/**/xcuserdata/
iOS/**/*.xcuserstate
iOS/**/.swiftpm/
iOS/**/.build/

# macOS
.DS_Store

# Claude Code session lock (pid/session id, not a project artifact)
.claude/scheduled_tasks.lock
__pycache__/
# Local device builds (xcodebuild -derivedDataPath build-device)
iOS/build-device/
