{"review_id": "6d616034-dc29-45b2-bd00-246855b51e4f", "package": "co.au.goalhero", "app_name": "Habit Hunter: Gamified Routine", "language": "it", "language_name": "Italian", "rating": 1, "text": "Didn't complete my quest when I did a task, won't run without an internet connection, and when I allow it to connect to the internet, it spams adds.", "author": "Anhel Raykova", "date": "2023-08-12T09:39:34Z", "thumbs_up": 1, "app_version": null, "developer_reply": "Hi, in order to complete a quest you need to do at least 30-50 habits to move your hero to wolf position. Please read the quest instruction again"}
{"review_id": "603b23e2-a8da-4087-863a-7a29e3116778", "package": "co.au.goalhero", "app_name": "Habit Hunter: Gamified Routine", "language": "it", "language_name": "Italian", "rating": 5, "text": "Perfect! I think the game design can be better, prettier than this...", "author": "Beatriz Sevilha", "date": "2023-08-11T20:35:40Z", "thumbs_up": 0, "app_version": "1.4.1", "developer_reply": null}
