{
  "name": "often-enough-api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "types": "wrangler types",
    "deploy:dev": "wrangler deploy",
    "migrate:dev": "wrangler d1 migrations apply DIRECTORY --remote",
    "deploy:production": "wrangler deploy --env production",
    "release:production": "node scripts/release-production.mjs",
    "migrate:production": "wrangler d1 migrations apply DIRECTORY --remote --env production"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.4",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.145.0"
  }
}
