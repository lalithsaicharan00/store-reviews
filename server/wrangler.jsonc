// The Often Enough API (Architecture/06. Server on Cloudflare.md).
// Top level = dev (api-dev.oftenenough.com). `env.production` = real users (api.oftenenough.com): `--env production`.
// Secrets (never in this file): TOKEN_KEY (signs access tokens; each environment its own), TEST_LOGIN_SECRET (dev only).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "often-enough-api-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api-dev.oftenenough.com", "custom_domain": true }],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "ENVIRONMENT": "dev",
    // The app's bundle ID: what Apple puts in an ID token's audience.
    "APPLE_AUDIENCES": "com.oftenenough.app",
    // Google OAuth client IDs, comma-separated: the iOS client and the web client (Architecture/Backlog.md, 1 Oct 2026).
    // Public values; the web client's secret is never used: the server only checks Google's signature.
    "GOOGLE_AUDIENCES": "367584981284-c8q0v1eqmtbng2nu75k3abjuih4s5b8k.apps.googleusercontent.com,367584981284-i2afctg5t1d702fch3300d4vacp3teod.apps.googleusercontent.com",
    // App Store purchases: the app's bundle ID, and which App Store environments this server accepts.
    // Dev takes Xcode's local StoreKit testing and the sandbox; production will take Production and Sandbox (App Review).
    "APPLE_BUNDLE_ID": "com.oftenenough.app",
    "APPLE_ENVIRONMENTS": "Production,Sandbox,Xcode",
    // Dev only: extra trusted roots (PEM), e.g. Xcode's StoreKit testing certificate. Empty: Apple's root only.
    "APPLE_EXTRA_ROOTS": "",
    // Dev only: GitHub Actions runs of this repository may use POST /v1/auth/ci (end-to-end tests).
    "CI_REPOSITORY": "lalithsaicharan00/store-reviews",
    // For the daily report's request numbers (Analytics Engine SQL API). Not a secret.
    "ACCOUNT_ID": "fd5d7e4921bb3f41c85bedb2fd2fb0eb",
    // The website may call sign-in, sign-out and delete from these origins (account deletion without the app).
    "WEB_ORIGINS": "https://oftenenough.com,https://www.oftenenough.com,https://site-dev.oftenenough.com,https://oftenenough.pages.dev,https://*.oftenenough.pages.dev"
  },
  "secrets": { "required": ["TOKEN_KEY", "TEST_LOGIN_SECRET"] },
  "durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "Account" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
  // Backups of accounts that don't sync (src/backup.ts). EU accounts' copies stay in the EU. Both buckets have a
  // lifecycle rule deleting copies 365 days after upload (server/README.md, "Deploy dev").
  "r2_buckets": [
    { "binding": "BACKUPS", "bucket_name": "often-enough-backups-dev" },
    { "binding": "BACKUPS_EU", "bucket_name": "often-enough-backups-dev-eu", "jurisdiction": "eu" }
  ],
  // Monitoring (src/report.ts): the daily report at 06:00 UTC. Request data points need Analytics Engine, which is
  // switched on once in the Cloudflare dashboard (Workers → Analytics Engine); then add, here and in production:
  //   "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "often_enough_dev" }]   (production: "often_enough")
  "triggers": { "crons": ["0 6 * * *"] },
  // Rate limits (Architecture 06 §6), per Cloudflare location; namespace IDs are unique per account.
  "ratelimits": [
    // Per account: syncs and backup reads. The app syncs at most every few seconds.
    { "name": "SYNC_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Per IP: sign-in and refresh.
    { "name": "AUTH_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    // Per device: backup uploads (the app uploads at most a few times a day; this only stops loops).
    { "name": "BACKUP_LIMIT", "namespace_id": "1003", "simple": { "limit": 2, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DIRECTORY",
      "database_name": "often-enough-directory-dev",
      "database_id": "c1d8f6e8-0169-4918-b99e-40c4bbaf9a47",
      "migrations_dir": "migrations"
    }
  ],
  // Production: real users only. Nothing that exists for testing is here: no test or CI sign-in (TEST_LOGIN_SECRET,
  // CI_REPOSITORY), no extra trusted roots, no Xcode StoreKit purchases. Its own directory, buckets, token key and
  // rate-limit counters. Bindings and vars are not inherited from the top level, so every one is repeated here.
  // Deploy: `npm run deploy:production` (server/README.md, "Production").
  "env": {
    "production": {
      "name": "often-enough-api",
      "routes": [{ "pattern": "api.oftenenough.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "APPLE_AUDIENCES": "com.oftenenough.app",
        "GOOGLE_AUDIENCES": "367584981284-c8q0v1eqmtbng2nu75k3abjuih4s5b8k.apps.googleusercontent.com,367584981284-i2afctg5t1d702fch3300d4vacp3teod.apps.googleusercontent.com",
        "APPLE_BUNDLE_ID": "com.oftenenough.app",
        // App Review buys with sandbox accounts, so the live server must take Sandbox too (Apple's guidance).
        "APPLE_ENVIRONMENTS": "Production,Sandbox",
        "APPLE_EXTRA_ROOTS": "",
        "CI_REPOSITORY": "",
        "ACCOUNT_ID": "fd5d7e4921bb3f41c85bedb2fd2fb0eb",
        "WEB_ORIGINS": "https://oftenenough.com,https://www.oftenenough.com"
      },
      "secrets": { "required": ["TOKEN_KEY"] },
      "triggers": { "crons": ["0 6 * * *"] },
      "durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "Account" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
      "r2_buckets": [
        { "binding": "BACKUPS", "bucket_name": "often-enough-backups" },
        { "binding": "BACKUPS_EU", "bucket_name": "often-enough-backups-eu", "jurisdiction": "eu" }
      ],
      "ratelimits": [
        { "name": "SYNC_LIMIT", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
        { "name": "AUTH_LIMIT", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
        { "name": "BACKUP_LIMIT", "namespace_id": "2003", "simple": { "limit": 2, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DIRECTORY",
          "database_name": "often-enough-directory",
          "database_id": "4db69eb1-103a-4831-acf4-7a7e3a3139b6",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
