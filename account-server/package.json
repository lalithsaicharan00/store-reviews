{
  "name": "often-enough-account",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "migrate:dev": "wrangler d1 migrations apply DB --remote",
    "deploy:dev": "wrangler deploy",
    "live:dev": "node scripts/live-check.mjs https://api-dev.oftenenough.com",
    "migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "release:production": "node scripts/release-production.mjs",
    "live:production": "node scripts/live-check.mjs https://api.oftenenough.com"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.4",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  }
}
