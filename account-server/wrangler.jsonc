// The move relay's Worker (account-server/README.md; Rulebook D15, D16). Since 21 Oct 2026 it holds no accounts.
// Top level = dev (api-dev.oftenenough.com, debug builds of the apps). `env.production` = real people
// (api.oftenenough.com, release builds): every command for it takes `--env production`. No secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "often-enough-account-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api-dev.oftenenough.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "dev"
  },
  // Per Cloudflare location, per minute. IDs are unique within the Cloudflare account.
  "ratelimits": [
    // Per IP: moving to a new phone (src/move.ts): making codes and trying them.
    { "name": "MOVE_LIMIT", "namespace_id": "3004", "simple": { "limit": 20, "period": 60 } }
  ],
  // Moving to a new phone with a code (src/move.ts; Rulebook D15): which channel is whose, and one relay per move.
  // SQLite-backed, as Workers Free requires.
  "durable_objects": {
    "bindings": [
      { "name": "MOVE_REGISTRY", "class_name": "MoveRegistry" },
      { "name": "MOVE_RELAY", "class_name": "MoveRelay" }
    ]
  },
  "migrations": [{ "tag": "move-v1", "new_sqlite_classes": ["MoveRegistry", "MoveRelay"] }],
  // Real people only. Bindings and vars aren't inherited from the top level, so each is repeated here.
  "env": {
    "production": {
      "name": "often-enough-account",
      "routes": [{ "pattern": "api.oftenenough.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production"
      },
      "ratelimits": [
        { "name": "MOVE_LIMIT", "namespace_id": "4004", "simple": { "limit": 20, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "MOVE_REGISTRY", "class_name": "MoveRegistry" },
          { "name": "MOVE_RELAY", "class_name": "MoveRelay" }
        ]
      }
    }
  }
}
