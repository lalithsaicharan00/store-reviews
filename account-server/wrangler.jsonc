// The Plus account's Worker (account-server/README.md; Rulebook D16; Current Work 110).
// Top level = dev (api-dev.oftenenough.com, debug builds of the apps). `env.production` = real people
// (api.oftenenough.com, release builds): every command for it takes `--env production`.
// Secrets, never in this file (D11): GOOGLE_WIF_SIGNING_KEY, the Worker's own key for keyless Google sign-in
// (`node scripts/make-wif-key.mjs [production]` makes it straight into Cloudflare); dev only: TEST_SIGN_IN_SECRET.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "often-enough-account-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api-dev.oftenenough.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "dev",
    // Google's OAuth web client "Often Enough sign-in" (project often-enough): the Android app asks for ID tokens for
    // it. Public; its secret is never used, the Worker only checks Google's signature.
    "GOOGLE_AUDIENCES": "367584981284-kihul3a8cfoftn4d0crtsf2utld84kgf.apps.googleusercontent.com",
    // Sign in with Apple on the iPhone: the app's bundle ID is the token's audience.
    "APPLE_AUDIENCES": "com.oftenenough.app",
    // The Android app on Google Play, whose purchases this Worker checks.
    "PLAY_PACKAGE": "com.oftenenough.app",
    // Keyless Google sign-in for the Play checks (src/play.ts; README, "Google Play, keyless"): Workload Identity
    // Federation in Google Cloud project often-enough. Public values; the signing key is the secret GOOGLE_WIF_SIGNING_KEY.
    "GOOGLE_PROJECT_NUMBER": "367584981284",
    "GOOGLE_WIF_POOL": "cloudflare-workers",
    "GOOGLE_WIF_PROVIDER": "often-enough-account",
    "GOOGLE_WIF_ISSUER": "https://api.oftenenough.com",
    "GOOGLE_WIF_SUBJECT": "often-enough-account-dev",
    "GOOGLE_WIF_KEY_ID": "account-dev-1",
    "GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL": "play-purchases@often-enough.iam.gserviceaccount.com",
    // Google Play's Real-time developer notifications (src/refunds.ts; README, "Refunds"): Pub/Sub pushes each one with
    // an OIDC token for this audience (its own subscription's), as this service account (no keys, no roles). Public.
    "GOOGLE_PUBSUB_AUDIENCE": "https://api-dev.oftenenough.com/v1/google/notifications",
    "GOOGLE_PUBSUB_SERVICE_ACCOUNT": "play-notifications-push@often-enough.iam.gserviceaccount.com",
    // Dev only: the debug app's stand-in purchases (token "stand-in…") count as bought, so families can be tested end
    // to end without Google Play. Never in production (test/production.test.ts checks it).
    "ACCEPT_STAND_IN_PURCHASES": "true"
  },
  // Daily, one job (src/worker.ts, DAILY): tidying (src/accounts.ts, tidy) and Google Play's voided purchases since the
  // day before, the backstop for its notifications (src/refunds.ts, sweepVoided).
  "triggers": { "crons": ["0 5 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "often-enough-accounts-dev", "database_id": "d705fc33-e79d-4446-a3f0-45c7a8a75520", "migrations_dir": "migrations" }
  ],
  // Per Cloudflare location, per minute. IDs are unique within the Cloudflare account.
  "ratelimits": [
    // Per IP: sign-in, making an account, deleting one (each needs a fresh Google or Apple token anyway).
    { "name": "AUTH_LIMIT", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } },
    // Per IP: opening and joining invites (tokens are 128-bit; this only stops anyone trying them in bulk).
    { "name": "INVITE_LIMIT", "namespace_id": "3002", "simple": { "limit": 30, "period": 60 } },
    // Per account: everything else.
    { "name": "CALL_LIMIT", "namespace_id": "3003", "simple": { "limit": 120, "period": 60 } },
    // Per IP: moving to a new phone (src/move.ts): making codes and trying them.
    { "name": "MOVE_LIMIT", "namespace_id": "3004", "simple": { "limit": 20, "period": 60 } }
  ],
  // Moving to a new phone with a code (src/move.ts; Rulebook D15): which channel is whose, and one relay per move.
  // SQLite-backed, as Workers Free requires.
  "durable_objects": {
    "bindings": [
      { "name": "MOVE_REGISTRY", "class_name": "MoveRegistry" },
      { "name": "MOVE_RELAY", "class_name": "MoveRelay" }
    ]
  },
  "migrations": [{ "tag": "move-v1", "new_sqlite_classes": ["MoveRegistry", "MoveRelay"] }],
  // Real people only. Bindings and vars aren't inherited from the top level, so each is repeated here.
  "env": {
    "production": {
      "name": "often-enough-account",
      "routes": [{ "pattern": "api.oftenenough.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "GOOGLE_AUDIENCES": "367584981284-kihul3a8cfoftn4d0crtsf2utld84kgf.apps.googleusercontent.com",
        "APPLE_AUDIENCES": "com.oftenenough.app",
        "PLAY_PACKAGE": "com.oftenenough.app",
        "GOOGLE_PROJECT_NUMBER": "367584981284",
        "GOOGLE_WIF_POOL": "cloudflare-workers",
        "GOOGLE_WIF_PROVIDER": "often-enough-account",
        "GOOGLE_WIF_ISSUER": "https://api.oftenenough.com",
        "GOOGLE_WIF_SUBJECT": "often-enough-account",
        "GOOGLE_WIF_KEY_ID": "account-production-1",
        "GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL": "play-purchases@often-enough.iam.gserviceaccount.com",
        "GOOGLE_PUBSUB_AUDIENCE": "https://api.oftenenough.com/v1/google/notifications",
        "GOOGLE_PUBSUB_SERVICE_ACCOUNT": "play-notifications-push@often-enough.iam.gserviceaccount.com"
      },
      "triggers": { "crons": ["0 5 * * *"] },
      // Made 16 Oct 2026 at the first production release.
      "d1_databases": [
        { "binding": "DB", "database_name": "often-enough-accounts", "database_id": "a4345b9f-1cb8-4649-acd9-e4dad9718481", "migrations_dir": "migrations" }
      ],
      "ratelimits": [
        { "name": "AUTH_LIMIT", "namespace_id": "4001", "simple": { "limit": 30, "period": 60 } },
        { "name": "INVITE_LIMIT", "namespace_id": "4002", "simple": { "limit": 30, "period": 60 } },
        { "name": "CALL_LIMIT", "namespace_id": "4003", "simple": { "limit": 120, "period": 60 } },
        { "name": "MOVE_LIMIT", "namespace_id": "4004", "simple": { "limit": 20, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "MOVE_REGISTRY", "class_name": "MoveRegistry" },
          { "name": "MOVE_RELAY", "class_name": "MoveRelay" }
        ]
      }
    }
  }
}
