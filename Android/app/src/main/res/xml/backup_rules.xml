<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier. Android's own backup is off (A26, 21 Oct 2026): our Google Drive backup is the only
     backup and the only way back. Nothing of this app is ever copied by the system. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
