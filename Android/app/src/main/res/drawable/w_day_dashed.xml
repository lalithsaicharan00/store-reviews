<?xml version="1.0" encoding="utf-8"?>
<!-- A Day cell with no goal that day (DayCell.kt): a dashed line 1.5 dp inside the edge, 3 on and 3 off; tinted. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <stroke android:width="1.5dp" android:color="#FF000000" android:dashWidth="3dp" android:dashGap="3dp" />
    <corners android:radius="7dp" />
</shape>
