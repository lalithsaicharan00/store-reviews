<resources>
    <style name="Theme.OftenEnough" parent="Theme.SplashScreen">
        <!-- The splash is Android's own: the logo's foreground on the Logo Guide's background, as Figma "01 · Splash screen" (13 Oct 2026). -->
        <item name="windowSplashScreenBackground">#0D0D0D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.OftenEnough.App</item>
    </style>
    <style name="Theme.OftenEnough.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/screen</item>
        <!-- A dialog dims what's behind it with Material's scrim, 32 % (Figma's date picker; Android's own default is 60 %). -->
        <item name="android:backgroundDimAmount">0.32</item>
    </style>
</resources>
