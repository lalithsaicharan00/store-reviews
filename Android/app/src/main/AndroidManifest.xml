<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reminders (Current Work 107): notifications, exact times, and planning again after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A running timer's Live Update: Android 16 shows it as a chip in the status bar (A11 D4). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- An alarm-style reminder fills the screen over the lock screen (5.11.4), only once the person allows it (5.11.5). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Google Drive: the person's own backup (A4, A39). INTERNET for Drive's own calls and Google's permission
         screen; ACCESS_NETWORK_STATE so the app can say "No internet" instead of waiting on a call that can't go. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- No advertising ID, ever (no ads, no tracking; Play's advertising ID declaration says No). Removed here so a
         Google library can never add it without us noticing. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <application
        android:name=".app.OftenEnoughApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OftenEnough">
        <activity
            android:name=".app.MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- uiMode: a theme change (the app's own or the phone's) redraws in place; Compose follows it (Theme.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <receiver android:name=".app.reminders.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".app.reminders.TimerStopReceiver" android:exported="false" />
        <!-- The widgets (Current Work 107, checkpoint 4): six fixed sizes, each with its setup screen. -->
        <receiver android:name=".app.widgets.OneHabitWidgetReceiver" android:exported="false" android:label="One habit">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_one_habit" />
        </receiver>
        <receiver android:name=".app.widgets.TodayWidgetReceiver" android:exported="false" android:label="Today">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today" />
        </receiver>
        <receiver android:name=".app.widgets.TodayLargeWidgetReceiver" android:exported="false" android:label="Today">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_large" />
        </receiver>
        <receiver android:name=".app.widgets.WeekWidgetReceiver" android:exported="false" android:label="This week">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week" />
        </receiver>
        <receiver android:name=".app.widgets.TasksWidgetReceiver" android:exported="false" android:label="Tasks">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks" />
        </receiver>
        <receiver android:name=".app.widgets.TasksLargeWidgetReceiver" android:exported="false" android:label="Tasks">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks_large" />
        </receiver>
        <!-- The alarm screen (5.11.4): over the lock screen, its own task, never in Recents. -->
        <activity
            android:name=".app.reminders.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OftenEnough.App"
            android:turnScreenOn="true" />
        <activity
            android:name=".app.widgets.WidgetSetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OftenEnough.App">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- The day's start moves every widget on, without the app. -->
        <receiver android:name=".app.widgets.WidgetDayReceiver" android:exported="false" />
    </application>
</manifest>
