{"review_id": "ff1e042a-2a3a-473e-b11e-02cc64125fd9", "package": "com.tasks.android", "app_name": "Tasks: To Do List & Reminders", "language": "bg", "language_name": "bg", "rating": 4, "text": "I really like the tasks app, but can't seem to change the language to English. Also it would be great if we are able to sort tasks by their time of finishing(e.g. 18. November before 19. November etc. and vice versa)", "author": "CAMİGROF", "date": "2023-10-27T11:22:36Z", "thumbs_up": 0, "app_version": "3.13.0", "developer_reply": null}
