{"review_id": "5f1629bf-5617-4c56-9bab-cdc9fa13d254", "package": "com.Dygie.Lusha", "app_name": "Lusha: ADHD Chores & Behavior", "language": "pt", "language_name": "Portuguese", "rating": 1, "text": "A minha filha não gostou da personagem porque não tinha cabelos como ela queria e também a cabeça era muito grande nem parece para a idade dela", "author": "Sofia Aguiar", "date": "2025-07-21T16:55:38Z", "thumbs_up": 2, "app_version": "2.98", "developer_reply": "Merci pour votre retour d'experience et désolé que votre fille ne se soit pas retrouvé dans l'avatar. Nous partageons ce commentaire à notre Game Artist."}
