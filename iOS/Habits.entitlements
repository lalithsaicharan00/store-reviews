<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Widgets read and write the app's data through this group (App Identity note). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.oftenenough.app</string>
	</array>
	<!-- iCloud's silent pushes, which CKSyncEngine listens for (Architecture 11 §4, §18). "development" for Xcode builds;
	     an App Store build gets "production" from its provisioning profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- The person's own iCloud, in the app's private container: sync with CloudKit (Architecture 11) and the dated
	     backup files in iCloud Drive (BackupFeatures.iCloudBackup). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.oftenenough.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.oftenenough.app</string>
	</array>
</dict>
</plist>
